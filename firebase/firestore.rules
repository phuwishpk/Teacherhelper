// Krucheck Firestore rules (DESIGN §38.5). Paste into Firebase console >
// Firestore Database > Rules. The backend writes with the service account
// (rules do not apply to it); signed-in users only read their own subtree.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
