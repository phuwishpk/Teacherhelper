# EduVision backend (Laravel). Copy to .env; never commit .env (repo is public).
# On Plesk .env lives outside the document root: <deployment path>/backend/.env

APP_NAME=EduVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Store UTC in the database; the app displays Asia/Bangkok (DESIGN §7.6).
APP_TIMEZONE=UTC

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: MariaDB in the OrbStack container "eduvision-mariadb" (KICKOFF B2).
# Plesk: the credentials of the database created in Plesk > Databases.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=eduvision
DB_USERNAME=eduvision
DB_PASSWORD=eduvision

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting: queue and cache both live in the database. No Redis (CLAUDE.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- EduVision (config/eduvision.php) ----
# teacher_join_code of the school created by SchoolSeeder. Use a random 8-char
# code on the server: in M0 this code is the only gate for teacher sign-up.
SEED_TEACHER_JOIN_CODE=DEMO2569
# GET /api/v1/health reports "degraded" when the queue heartbeat is older than this.
HEARTBEAT_MAX_AGE_MINUTES=3
