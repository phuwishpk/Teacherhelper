# EduVision backend (Laravel). Copy to .env; never commit .env (repo is public).
# On Plesk .env lives outside the document root: <deployment path>/backend/.env

APP_NAME=EduVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Store UTC in the database; the app displays Asia/Bangkok (DESIGN §7.6).
APP_TIMEZONE=UTC

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Teacher passwords only. Student PINs use a fixed low cost (CredentialIssuer::PIN_HASH_ROUNDS).
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: MariaDB in the OrbStack container "eduvision-mariadb" (KICKOFF B2).
# Plesk: the credentials of the database created in Plesk > Databases.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=eduvision
DB_USERNAME=eduvision
DB_PASSWORD=eduvision

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting: queue and cache both live in the database. No Redis (CLAUDE.md).
QUEUE_CONNECTION=database
# Must exceed the longest job (GradeScanJob: 240 s) so a second cron worker
# never takes over a job that is still running.
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- EduVision (config/eduvision.php) ----
# teacher_join_code of the school created by SchoolSeeder. Use a random 8-char
# code on the server: in M0 this code is the only gate for teacher sign-up.
SEED_TEACHER_JOIN_CODE=DEMO2569
# GET /api/v1/health reports "degraded" when the queue heartbeat is older than this.
HEARTBEAT_MAX_AGE_MINUTES=3
# System admin created by `php artisan db:seed` (AdminSeeder). Leave both empty
# to create none; on the server set them once, seed, then clear them again.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the QR on every printed worksheet (DESIGN §5.4). Required before the
# first worksheet is printed. Generate a long random value, for example:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Keep it stable: changing it makes every worksheet printed before unreadable.
QR_SIGNING_KEY=
# Students rendered per RenderWorksheetsJob (DESIGN §5.5).
WORKSHEET_BATCH_SIZE=10

# POST /scans size limits in KB (DESIGN §9.4): the warped page and each crop,
# all WebP. PHP on the server must also allow the request (Plesk > PHP
# Settings): upload_max_filesize >= 8M, post_max_size >= 16M and
# max_file_uploads >= 100 (PHP drops files past this limit; the API then
# answers 503 too_many_files and the app retries once the limit is raised).
SCAN_MAX_PAGE_KB=4096
SCAN_MAX_CROP_KB=1024

# ---- Gemini (DESIGN §10, config/services.php) ----
# Server-wide key, optional: a teacher's own key (app > ตั้งค่า) is used first.
# With neither, answers go to the teacher as "ตรวจเอง" (ai_key_missing).
# Paid tier only (free tier may train on student data). Restrict the key to
# the Generative Language API and set a budget alert in Cloud Billing.
# Check it on the server: artisan eduvision:gemini-check --generate
GEMINI_API_KEY=
# Latest stable Flash when implemented (2026-09); change without code edits.
GEMINI_MODEL=gemini-3.8-flash
# true = offline deterministic fake (no network, no cost) for a dev machine or
# a demo. It still needs "a key": save any key in the app or set
# GEMINI_API_KEY to any value. Never true in production (ignored there with
# an error in the log; artisan eduvision:gemini-check warns about it).
GEMINI_FAKE=false
# REST base URL; override only for a proxy or tests.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Seconds per request (DESIGN §10.1) and parallel requests per worker pass (§7.2).
GEMINI_TIMEOUT=30
GEMINI_CONCURRENCY=8
# Gemini 3+: low | medium | high thinking (cost and latency grow with it).
# Leave empty for a model without thinking levels.
GEMINI_THINKING_LEVEL=low
# Gemini 3+ deprecates temperature; true only with a 2.x model.
GEMINI_SEND_TEMPERATURE=false
# Media resolution per image (DESIGN §21.5): low | medium | high. Keep every
# student image at high until eduvision:calibrate-gemini (§21.10) passes at
# the lower target (short -> low, work -> medium).
GEMINI_MEDIA_SHORT=high
GEMINI_MEDIA_WORK=high
GEMINI_MEDIA_PAGE=high
GEMINI_MEDIA_DOCUMENT=medium
# true = mediaResolution on each image part (needs an API version that has it);
# false = one generationConfig.mediaResolution per call (highest of its parts).
GEMINI_MEDIA_PER_PART=false
# Pass thresholds of artisan eduvision:calibrate-gemini (§21.10): samples per
# kind, the largest accuracy drop vs high (0.02 = 2 points) and how many
# answers may change between full and not full marks.
GEMINI_CALIBRATION_MIN_SAMPLES=40
GEMINI_CALIBRATION_MAX_DROP=0.02
GEMINI_CALIBRATION_MAX_SCORE_FLIPS=0
# Questions per extract_batch / extract_page call (§21.4); more are split.
GEMINI_PAGE_MAX_QUESTIONS=15
# Answers decided without Gemini (§21.3). An answer box with ink_ratio below
# GRADING_BLANK_INK_MAX gets 0 points as "ไม่ได้ตอบ" (the teacher still sees
# it in the review queue). CNN skip: a numeric short answer the phone's digit
# reader reads with confidence >= GRADING_CNN_SKIP_MIN_CONFIDENCE, exactly as
# an accepted answer, gets full marks; GRADING_CNN_SKIP_SAMPLE_RATE of them go
# to the teacher. Keep it false until the calibration passes on real handwriting.
GRADING_BLANK_INK_MAX=0.005
GRADING_CNN_SKIP_ENABLED=false
GRADING_CNN_SKIP_MIN_CONFIDENCE=0.97
GRADING_CNN_SKIP_SAMPLE_RATE=0.10
# Whole-page submissions (§19.4): pages per hand-in (PDF pages count) and MB
# per file. PHP needs upload_max_filesize >= 10M and post_max_size >= 55M.
SUBMISSION_MAX_PAGES=5
SUBMISSION_MAX_FILE_MB=10
# Teachers' documents (answer keys, question sheets, §19.5): MB per file,
# MB per read (every file of one Gemini call, sent inline), pages per read
# (longer documents need a page range) and days the files are kept (the read
# result stays).
DOCUMENT_MAX_FILE_MB=10
DOCUMENT_MAX_TOTAL_MB=20
DOCUMENT_MAX_PAGES=30
DOCUMENT_RETENTION_DAYS=30
# Google Classroom cron sync (§19.3): assignments whose submissions one round
# syncs, and seconds after which a round starts no new work (the cron worker
# pass is 50 s).
CLASSROOM_SYNC_MAX_COURSEWORK=20
CLASSROOM_SYNC_BUDGET_SECONDS=40
# Price per million tokens in USD and the baht rate, for the cost the app
# shows before a document is read (§19.5, §21.1). Check Google's current
# price first: Gemini 3.x Flash doubles from 2027-01-01. Empty = no baht
# figure (tokens only).
GEMINI_PRICE_INPUT_PER_M=0.50
GEMINI_PRICE_OUTPUT_PER_M=3.00
USD_THB_RATE=33
# An indicator counts as "ผ่าน" when its mastery is at least this (§20.3).
MASTERY_PASS_THRESHOLD=0.5
# The nightly student analysis (§20.8): inline requests per Gemini batch.
ANALYSIS_BATCH_MAX=200

# ---- Push notifications: Firebase Cloud Messaging (DESIGN §7.6, §9.9) ----
# Path to the Firebase service-account JSON key (Firebase console > Project
# settings > Service accounts > Generate new private key). Keep the file
# OUTSIDE the document root and out of git, e.g.
#   /var/www/vhosts/<domain>/private/firebase-service-account.json
# A relative path is resolved against backend/. Empty = no pushes: they are
# only written to the log. Check it on the server: artisan eduvision:fcm-check
FIREBASE_CREDENTIALS=
# Optional: overrides project_id of the key file.
FIREBASE_PROJECT_ID=
# Seconds per FCM / OAuth request.
FIREBASE_TIMEOUT=10

# ---- Google Classroom (DESIGN §18, KICKOFF part 6) ----
# OAuth client of type "Web application" in the Google Cloud project (G4).
# The client ID may also go to the Android app as
# --dart-define=GOOGLE_SERVER_CLIENT_ID (native sign-in; optional, the app
# falls back to the browser flow below). The SECRET must never be committed
# or pasted in a chat. Both empty = the Classroom endpoints answer 503
# google_not_configured (everything else works).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Callback of the browser connect flow (POST /api/v1/google/oauth/url ->
# Google -> GET /google/oauth/callback). Register EXACTLY this URI under
# "Authorized redirect URIs" of the Web OAuth client (scheme, host, port and
# path must match). Empty = APP_URL + /google/oauth/callback.
#   local:      http://127.0.0.1:8000/google/oauth/callback
#   production: https://teacherhelper.phuwish.com/google/oauth/callback
# Codes from the Android app (POST /google/connect) never use it.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google/oauth/callback
# Seconds per request to oauth2 / classroom / drive.googleapis.com.
GOOGLE_TIMEOUT=20
# Optional link added to every courseWork's instructions (e.g. the app's Play
# Store page) where students read the per-question explanations.
GOOGLE_CLASSROOM_APP_LINK=
