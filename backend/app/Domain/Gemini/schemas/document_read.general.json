{
  "type": "object",
  "properties": {
    "course": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "subject_code": { "type": "string" },
        "grade_level": { "type": "integer", "minimum": 1, "maximum": 12 },
        "semester": { "type": "integer", "minimum": 0, "maximum": 2 },
        "academic_year": { "type": "integer", "minimum": 2500, "maximum": 2700 },
        "hours": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "description": { "type": "string" }
      }
    },
    "indicators": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["code"]
      }
    },
    "units": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "position": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "title": { "type": "string" },
          "hours": { "type": "integer", "minimum": 0, "maximum": 2000 },
          "description": { "type": "string" },
          "indicator_codes": { "type": "array", "maxItems": 100, "items": { "type": "string" } }
        },
        "required": ["title"]
      }
    },
    "lesson_plans": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "position": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "unit_position": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "title": { "type": "string" },
          "hours": { "type": "integer", "minimum": 0, "maximum": 2000 },
          "objectives": { "type": "string" },
          "content": { "type": "string" },
          "activities": { "type": "string" },
          "assessment": { "type": "string" },
          "indicator_codes": { "type": "array", "maxItems": 100, "items": { "type": "string" } }
        },
        "required": ["title"]
      }
    },
    "notes_th": { "type": "string" }
  },
  "required": ["indicators", "units", "lesson_plans"]
}
