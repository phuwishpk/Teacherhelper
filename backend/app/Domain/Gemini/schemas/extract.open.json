{
  "type": "object",
  "properties": {
    "blank": { "type": "boolean" },
    "suspicious_instruction": { "type": "boolean" },
    "legibility": { "type": "string", "enum": ["clear", "readable", "hard"] },
    "transcription": { "type": "string" },
    "criteria": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": { "type": "integer", "minimum": 1 },
          "level": { "type": "string", "enum": ["met", "partially_met", "not_met"] },
          "evidence_th": { "type": "string" }
        },
        "required": ["criterion_id", "level"]
      }
    },
    "error_types": { "type": "array", "maxItems": 9, "items": { "type": "string", "enum": [
      "concept", "procedure", "calculation", "careless", "incomplete",
      "misread_question", "spelling_grammar", "no_answer", "other"] } },
    "summary_th": { "type": "string" }
  },
  "required": ["blank", "suspicious_instruction", "legibility", "transcription", "criteria", "error_types"]
}
