{
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "apply_plan": {
      "type": "boolean"
    },
    "need_data": {
      "type": "object",
      "properties": {
        "set": {
          "type": "string",
          "enum": [
            "classroom_summary",
            "student_history",
            "assignment_analysis"
          ]
        },
        "classroom_id": {
          "type": "integer"
        },
        "student_label": {
          "type": "string",
          "maxLength": 8
        },
        "assignment_id": {
          "type": "integer"
        }
      },
      "required": [
        "set"
      ]
    },
    "need_file": {
      "type": "boolean"
    },
    "plan": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "questions",
            "rubric",
            "indicators",
            "gradebook",
            "practice",
            "file"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "assignment_id": {
              "type": "integer"
            },
            "new_classroom_id": {
              "type": "integer"
            },
            "new_course_id": {
              "type": "integer"
            },
            "new_title": {
              "type": "string",
              "maxLength": 255
            },
            "new_kind": {
              "type": "string",
              "enum": [
                "worksheet",
                "freeform",
                "exam"
              ]
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "mcq",
                  "short",
                  "show_work",
                  "open",
                  "true_false",
                  "numeric"
                ]
              },
              "prompt_text": {
                "type": "string",
                "maxLength": 2000
              },
              "options": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "correct_options": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              },
              "accepted_answers": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 255
                }
              },
              "numeric_value": {
                "type": "string",
                "maxLength": 20
              },
              "reference_steps": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "model_answer": {
                "type": "string",
                "maxLength": 4000
              },
              "points": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 100
              },
              "explanation": {
                "type": "string",
                "maxLength": 600
              },
              "indicator_codes": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "needs_figure": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "prompt_text",
              "points"
            ]
          }
        },
        "question_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "criteria": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 1000
              },
              "points": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "is_core": {
                "type": "boolean"
              }
            },
            "required": [
              "description",
              "points",
              "is_core"
            ]
          }
        },
        "reference_steps": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "indicators": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "new",
                  "existing"
                ]
              },
              "code": {
                "type": "string",
                "maxLength": 40
              },
              "parent_code": {
                "type": "string",
                "maxLength": 40
              },
              "name": {
                "type": "string",
                "maxLength": 1000
              },
              "grade_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "reason": {
                "type": "string",
                "maxLength": 300
              },
              "question_positions": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            },
            "required": [
              "action"
            ]
          }
        },
        "course_id": {
          "type": "integer"
        },
        "categories": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "drop_lowest": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "is_homework_default": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "weight"
            ]
          }
        },
        "cutoffs": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "skill_code": {
          "type": "string",
          "maxLength": 40
        },
        "practice_items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "answer_type": {
                "type": "string",
                "enum": [
                  "numeric",
                  "short",
                  "mcq"
                ]
              },
              "prompt_text": {
                "type": "string",
                "maxLength": 2000
              },
              "options": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 255
                }
              },
              "correct_option": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "accepted_answers": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "maxLength": 255
                }
              },
              "numeric_value": {
                "type": "string",
                "maxLength": 20
              },
              "explanation": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "answer_type",
              "prompt_text"
            ]
          }
        },
        "file_action": {
          "type": "string",
          "enum": [
            "answer_key",
            "exam",
            "course",
            "lesson_plan"
          ]
        },
        "document_ids": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "target"
      ]
    }
  },
  "required": [
    "answer"
  ],
  "additionalProperties": false
}
