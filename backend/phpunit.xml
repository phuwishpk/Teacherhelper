<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite runs in one process; mPDF (worksheets, login cards) needs headroom. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Never read a cached config/routes/events: after `artisan optimize` bootstrap/cache/config.php
             holds the .env values (and would ignore every value below, e.g. run RefreshDatabase against the
             developer's database). These paths never exist; TestCase::setUp also refuses a cached app. -->
        <env name="APP_CONFIG_CACHE" value="storage/framework/testing/no-config-cache.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="storage/framework/testing/no-routes-cache.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="storage/framework/testing/no-events-cache.php" force="true"/>
        <!-- Fixed test-only key so the suite (and CI) never depends on a local .env. Not a secret. -->
        <env name="APP_KEY" value="base64:dGVzdGluZy1vbmx5LWtleS1ub3QtYS1zZWNyZXQtMDA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="QR_SIGNING_KEY" value="testing-qr-signing-key-not-a-secret"/>
        <!-- Never the real Gemini: the offline fake with a dummy server key (tests that need "no key" clear it). -->
        <env name="GEMINI_FAKE" value="true" force="true"/>
        <env name="GEMINI_API_KEY" value="testing-server-gemini-key-not-real" force="true"/>
        <env name="GEMINI_MODEL" value="gemini-3.8-flash" force="true"/>
    </php>
</phpunit>
